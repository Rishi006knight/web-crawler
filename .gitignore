# ==========================================
# Web Crawler Monorepo (.gitignore)
# ==========================================

# ------------------------------------------
# Backend (Spring Boot & Maven)
# ------------------------------------------
**/target/
target/
backend/target/
*.class

# Maven Release & Dependency Artifacts
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Packaged Binaries
*.jar
*.war
*.ear

# ------------------------------------------
# Frontend (React, Vite, Node)
# ------------------------------------------
**/node_modules/
node_modules/
frontend/node_modules/
**/dist/
dist/
frontend/dist/
dist-ssr/
*.local
.eslintcache

# NPM / Yarn / PNPM Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Testing & JMeter Performance Artifacts
# ------------------------------------------
results.jtl
*.jtl
jmeter.log
test_results.log

# ------------------------------------------
# Redis & Databases
# ------------------------------------------
dump.rdb
*.rdb

# ------------------------------------------
# IDE & Editor Files
# ------------------------------------------
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
.classpath
.project
.settings/
.factorypath
bin/

# ------------------------------------------
# OS Metadata & Temp Files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.bat
*.tmp
*.bak
*~
