# ==========================================
# Web Crawler Monorepo (.gitignore)
# ==========================================

# ------------------------------------------
# Sensitive Files & Secrets (DO NOT COMMIT)
# ------------------------------------------
*.env
*.env.*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Secret Spring Boot property files
*application-local.properties
*application-secret.properties
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-secret.properties

# Certificates, Keys & Credentials
*.pem
*.key
*.pkcs12
*.p12
*.pfx
credentials.json
secrets/

# ------------------------------------------
# Old & Unnecessary Advanced Version Files
# ------------------------------------------
backend/src/src/

# ------------------------------------------
# Backend (Spring Boot & Maven)
# ------------------------------------------
**/target/
target/
backend/target/
*.class

# Maven Release & Dependency Artifacts
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Packaged Binaries
*.jar
*.war
*.ear

# ------------------------------------------
# Frontend (React, Vite, Node)
# ------------------------------------------
**/node_modules/
node_modules/
frontend/node_modules/
**/dist/
dist/
frontend/dist/
dist-ssr/
*.local
.eslintcache

# NPM / Yarn / PNPM Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Testing & JMeter Performance Artifacts
# ------------------------------------------
results.jtl
*.jtl
jmeter.log
test_results.log

# ------------------------------------------
# Redis & Databases
# ------------------------------------------
dump.rdb
*.rdb
*.sqlite
*.db

# ------------------------------------------
# IDE & Editor Files
# ------------------------------------------
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
.classpath
.project
.settings/
.factorypath
bin/

# ------------------------------------------
# OS Metadata & Temp Files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.bat
powershell.cmd
*.tmp
*.bak
*~
